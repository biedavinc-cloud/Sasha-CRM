{
  "name": "Lead",
  "type": "object",
  "properties": {
    "lead_id": {
      "type": "string"
    },
    "client_id": {
      "type": "string"
    },
    "full_name": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "source": {
      "type": "string",
      "enum": [
        "partner_referral",
        "walk_in",
        "social_media",
        "website",
        "other"
      ],
      "default": "partner_referral"
    },
    "partner_id": {
      "type": "string"
    },
    "partner_name": {
      "type": "string"
    },
    "referral_code": {
      "type": "string"
    },
    "service_interest": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "new",
        "contacted",
        "consultation_booked",
        "appointment_booked",
        "completed",
        "lost",
        "cancelled"
      ],
      "default": "new"
    },
    "notes": {
      "type": "string"
    }
  },
  "required": [
    "full_name",
    "phone"
  ],
  "rls": {
    "read": {
      "user_condition": {
        "role": "admin"
      }
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}