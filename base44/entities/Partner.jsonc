{
  "name": "Partner",
  "type": "object",
  "properties": {
    "partner_id": {
      "type": "string"
    },
    "business_name": {
      "type": "string"
    },
    "partner_type": {
      "type": "string",
      "enum": [
        "hair_salon",
        "beauty_salon",
        "spa",
        "gym",
        "influencer",
        "corporate",
        "hotel",
        "other"
      ],
      "default": "hair_salon"
    },
    "contact_person": {
      "type": "string"
    },
    "email": {
      "type": "string"
    },
    "phone": {
      "type": "string"
    },
    "address": {
      "type": "string"
    },
    "status": {
      "type": "string",
      "enum": [
        "active",
        "suspended",
        "inactive",
        "pending"
      ],
      "default": "pending"
    },
    "referral_code": {
      "type": "string"
    },
    "referral_link": {
      "type": "string"
    },
    "user_id": {
      "type": "string"
    },
    "commission_percentage": {
      "type": "number",
      "default": 10
    },
    "commission_basis": {
      "type": "string",
      "enum": [
        "gross",
        "profit"
      ],
      "default": "gross"
    },
    "eligible_service_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "excluded_service_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "min_transaction_amount": {
      "type": "number"
    },
    "max_commission": {
      "type": "number"
    },
    "attribution_window_days": {
      "type": "number",
      "default": 30
    },
    "effective_date": {
      "type": "string",
      "format": "date"
    },
    "expiry_date": {
      "type": "string",
      "format": "date"
    },
    "contract_notes": {
      "type": "string"
    }
  },
  "required": [
    "business_name",
    "referral_code",
    "user_id"
  ],
  "rls": {
    "read": {
      "$or": [
        {
          "data.user_id": "{{user.id}}"
        },
        {
          "user_condition": {
            "role": "admin"
          }
        }
      ]
    },
    "create": {
      "user_condition": {
        "role": "admin"
      }
    },
    "update": {
      "user_condition": {
        "role": "admin"
      }
    },
    "delete": {
      "user_condition": {
        "role": "admin"
      }
    }
  }
}